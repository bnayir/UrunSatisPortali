@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kozmetik Portalı</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #3b82f6;
            --secondary-color: #1e293b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .nav-link {
            font-weight: 500;
            transition: all 0.2s ease;
            padding: 0.5rem 1rem !important;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
                transform: translateY(-1px);
            }

        .dropdown-menu {
            border-radius: 15px;
            border: none;
            padding: 10px;
            min-width: 240px;
        }

        .dropdown-item {
            border-radius: 10px;
            padding: 8px 15px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .dropdown-item:hover {
                background-color: #eff6ff;
                color: var(--primary-color);
                padding-left: 20px;
            }

        .dropdown-header {
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-top: 5px;
        }

        .animate.slideIn {
            animation-duration: 0.3s;
            animation-fill-mode: both;
            animation-name: slideIn;
        }

        @@keyframes slideIn {
            0% {
                transform: translateY(1rem);
                opacity: 0;
            }

            100% {
                transform: translateY(0rem);
                opacity: 1;
            }
        }

        .cart-badge {
            font-size: 0.7rem;
            min-width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border: none;
            border-radius: 50px;
        }

        main {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top mb-0">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-magic me-2"></i>KOZMETİK<span class="text-dark">PORTALI</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1 opacity-50"></i> Anasayfa
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="catDrop" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-th-large me-1 opacity-50"></i> Kategoriler
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 mt-2 animate slideIn" aria-labelledby="catDrop">
                                <li class="dropdown-header fw-bold text-uppercase">Makyaj</li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="1"><i class="fas fa-chevron-right me-2 small text-primary"></i>Dudak Makyajı</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="15"><i class="fas fa-chevron-right me-2 small text-primary"></i>Göz Makyajı</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="3"><i class="fas fa-chevron-right me-2 small text-primary"></i>Ten Makyajı</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header fw-bold text-uppercase">Cilt Bakımı</li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="4"><i class="fas fa-leaf me-2 small text-success"></i>Serumlar</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="5"><i class="fas fa-sun me-2 small text-warning"></i>Güneş Kremleri</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-bold text-center text-primary" asp-area="" asp-controller="Home" asp-action="Index">Tüm Kategoriler</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Contact" asp-action="Index">
                                <i class="fas fa-envelope me-1 opacity-50"></i> İletişim
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-shield-halved me-1"></i> Admin Paneli
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-lg-2">
                            <a class="nav-link d-flex align-items-center" asp-area="" asp-controller="Wishlist" asp-action="Index">
                                <i class="fas fa-heart text-danger me-1"></i>
                                <span class="d-none d-xl-inline small fw-bold">Favoriler</span>
                            </a>
                        </li>

                        <li class="nav-item me-lg-3">
                            <a class="nav-link position-relative d-flex align-items-center bg-light rounded-pill px-3"
                               asp-area="" asp-controller="Cart" asp-action="Index" style="height: 40px;">
                                <i class="fas fa-shopping-cart text-primary"></i>
                                <span class="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm">
                                    @(Context.Session.GetString("CartCount") ?? "0")
                                </span>
                                <span class="ms-2 d-none d-xl-inline small fw-bold text-dark">Sepetim</span>
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle bg-white border rounded-pill px-3 d-flex align-items-center shadow-sm"
                                   href="#" id="userDrop" data-bs-toggle="dropdown" style="height: 40px;">
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity?.Name&background=3b82f6&color=fff"
                                         class="rounded-circle me-2" width="24" height="24">
                                    <span class="small fw-bold text-dark">@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 animate slideIn">
                                    <li><a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="fas fa-user-circle me-2 opacity-50"></i>Profilim</a></li>
                                    <li><a class="dropdown-item py-2" asp-area="" asp-controller="Order" asp-action="Index"><i class="fas fa-box me-2 opacity-50"></i>Siparişlerim</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                            <button type="submit" class="dropdown-item text-danger py-2"><i class="fas fa-power-off me-2"></i> Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-dark fw-bold" asp-area="Identity" asp-page="/Account/Login">Giriş</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <footer class="bg-white border-top mt-auto">
        @* --- NEWSLETTER SECTION (GÜNCELLENDİ) --- *@
        <div class="newsletter-section py-5 bg-dark text-white text-center shadow-lg">
            <div class="container">
                <h3 class="mb-2 fw-bold">Kampanyalardan İlk Sizin Haberiniz Olsun!</h3>
                <p class="mb-4 text-white-50">En yeni ürünler ve özel indirimler e-posta adresinize gelsin.</p>
                <div class="row justify-content-center">
                    <div class="col-md-6 col-lg-5">
                        <form id="subscribeForm" class="input-group">
                            <input type="email" name="email" id="subEmail" class="form-control rounded-pill-start px-4 border-0" placeholder="E-posta adresiniz..." required>
                            <button type="button" onclick="submitNewsletter()" class="btn btn-primary rounded-pill-end px-4 fw-bold">Abone Ol</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="container py-5">
            <div class="row align-items-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="fw-bold text-primary mb-0"><i class="fas fa-magic me-2"></i>KOZMETİK PORTALI</h5>
                    <p class="small text-muted mt-2">Güzelliğin teknoloji ile buluştuğu nokta.</p>
                </div>
                <div class="col-md-4 text-center text-muted small">
                    &copy; 2025 - Tüm Hakları Saklıdır.<br>
                    <span class="text-primary fw-bold">Antalya Kozmetik Geliştirici Ekibi</span>
                </div>
                <div class="col-md-4 text-md-end text-center">
                    <div class="social-links mb-3">
                        <a href="#" class="text-muted me-3 fs-5"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-muted me-3 fs-5"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="fab fa-twitter"></i></a>
                    </div>
                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small">v1.2.5 Final</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* --- JAVASCRIPT HATA DÜZELTME (@@ İLE ESCAPE EDİLDİ) --- *@
    <script>
        function submitNewsletter() {
            var emailInput = document.getElementById("subEmail");
            var email = emailInput.value.trim();

            // @@ karakteri Razor hatasını önlemek için çiftlendi
            if (!email || !email.includes("@@")) {
                alert("Lütfen geçerli bir e-posta adresi giriniz.");
                return;
            }

            $.post("/Home/Subscribe", { email: email }, function (response) {
                if (response.success) {
                    alert(response.message); //
                    emailInput.value = "";
                } else {
                    alert(response.message); //
                }
            }).fail(function() {
                alert("Bağlantı hatası oluştu, lütfen daha sonra tekrar deneyiniz.");
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>