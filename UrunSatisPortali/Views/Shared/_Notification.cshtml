@* Views/Shared/_Notification.cshtml - Artık TempData değil, URL (Query String) okur. *@
@{
    var statusMessage = Context.Request.Query["status"].ToString();
    string message = "";
    string alertType = "";

    // --- Başarılı İşlemler ---
    if (statusMessage == "created")
    {
        message = "Ürün başarıyla oluşturuldu!";
        alertType = "success";
    }
    else if (statusMessage == "deleted")
    {
        message = "Ürün başarıyla silindi!";
        alertType = "success";
    }
    else if (statusMessage == "updated")
    {
        message = "Ürün başarıyla güncellendi!";
        alertType = "success";
    }
    // -------------------------

    if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@alertType alert-dismissible fade show mt-3" role="alert">
            <strong>@message</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}