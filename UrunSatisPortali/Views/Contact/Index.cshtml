@{
    ViewData["Title"] = "İletişim";
}

<div class="container py-5">
    @* --- BAŞLIK --- *@
    <div class="text-center mb-5">
        <h1 class="fw-extra-bold display-4 text-dark">Bizimle <span class="text-primary text-gradient">İletişime Geçin</span></h1>
        <p class="text-muted lead">Sorularınız, önerileriniz veya iş birliği talepleriniz için buradayız.</p>
    </div>

    <div class="row g-5">
        @* --- İLETİŞİM BİLGİLERİ --- *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="d-flex align-items-center mb-4">
                    <div class="icon-box bg-primary-soft text-primary rounded-circle p-3 me-3" style="background: #eef2ff;">
                        <i class="fas fa-map-marker-alt fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Adresimiz</h6>
                        <p class="text-muted small mb-0">Üniversite Cad. No:123, Antalya/Türkiye</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="icon-box bg-success-soft text-success rounded-circle p-3 me-3" style="background: #ecfdf5;">
                        <i class="fas fa-phone-alt fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Telefon</h6>
                        <p class="text-muted small mb-0">+90 (242) 123 45 67</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="icon-box bg-info-soft text-info rounded-circle p-3 me-3" style="background: #e0f2fe;">
                        <i class="fas fa-envelope fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">E-Posta</h6>
                        <p class="text-muted small mb-0">destek@kozmetikportali.com</p>
                    </div>
                </div>

                @* Harita *@
                <div class="mt-auto rounded-4 overflow-hidden border shadow-sm" style="height: 200px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d102126.54486518458!2d30.638531!3d36.899808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14c39aaeddadadc1%3A0xf3c8004f21876e0!2sAntalya!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>

        @* --- İLETİŞİM FORMU --- *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-pill px-4 border-0 shadow-sm mb-4 animate__animated animate__fadeIn">
                        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                @* Form verileri SendMessage aksiyonuna gönderiliyor *@
                <form asp-controller="Contact" asp-action="SendMessage" method="post">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Adınız Soyadınız</label>
                            @* 'Name' özelliği modeldekiyle eşleşmeli *@
                            <input type="text" name="Name" class="form-control form-control-lg rounded-pill border-light bg-light shadow-none fs-6" placeholder="Örn: Ahmet Yılmaz" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">E-Posta Adresiniz</label>
                            @* 'Email' özelliği modeldekiyle eşleşmeli *@
                            <input type="email" name="Email" class="form-control form-control-lg rounded-pill border-light bg-light shadow-none fs-6" placeholder="orn@mail.com" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Konu</label>
                            @* 'Subject' özelliği modeldekiyle eşleşmeli *@
                            <input type="text" name="Subject" class="form-control form-control-lg rounded-pill border-light bg-light shadow-none fs-6" placeholder="Hangi konuda yazıyorsunuz?" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Mesajınız</label>
                            @* 'Content' özelliği modeldekiyle eşleşmeli (Önemli Değişiklik) *@
                            <textarea name="Content" rows="5" class="form-control rounded-4 border-light bg-light shadow-none fs-6" placeholder="Mesajınızı buraya bırakın..." required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm mt-2">
                                Mesajı Gönder <i class="fas fa-paper-plane ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .text-gradient {
        background: linear-gradient(to right, #60a5fa, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .form-control:focus {
        background-color: #fff !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.1) !important;
    }

    .bg-white {
        background-color: #ffffff !important;
    }
</style>