@model int
@{
    ViewData["Title"] = "Sipariş Başarılı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-5 p-5 bg-white mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <div class="icon-circle bg-success text-white d-inline-flex align-items-center justify-content-center rounded-circle shadow-lg"
                 style="width: 100px; height: 100px;">
                <i class="fas fa-check fa-3x"></i>
            </div>
        </div>

        <h2 class="fw-extra-bold text-dark mb-3">Siparişiniz Başarıyla Alındı!</h2>
        <p class="text-muted mb-4 fs-5">
            Harika bir seçim yaptınız. Sipariş numaranız: <strong class="text-primary">#ORD-@Model.ToString().PadLeft(5, '0')</strong>
        </p>

        <div class="alert alert-light border-0 rounded-4 p-3 mb-4 small text-start">
            <i class="fas fa-info-circle text-primary me-2"></i> Sipariş detaylarınızı "Siparişlerim" sayfasından takip edebilir, kargo durumunu kontrol edebilirsiniz.
        </div>

        <div class="d-grid gap-3">
            <a asp-controller="Order" asp-action="Index" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm">
                Siparişlerime Git
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-lg rounded-pill fw-bold py-3 text-muted">
                Alışverişe Devam Et
            </a>
        </div>
    </div>
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .icon-circle {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }
</style>