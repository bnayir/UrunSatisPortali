@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@model UrunSatisPortali.Models.Product

@{
    // Favori kontrolü için session'dan listeyi alıyoruz
    var wishlistJson = Context.Session.GetString("WishlistSession");
    var wishlistIds = wishlistJson != null
        ? JsonConvert.DeserializeObject<List<UrunSatisPortali.Models.Product>>(wishlistJson).Select(x => x.Id).ToList()
        : new List<int>();
}

<div class="container py-5">
    @* --- BREADCRUMB --- *@
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Anasayfa</a></li>
            <li class="breadcrumb-item active text-primary fw-bold">@Model.Category?.Name</li>
        </ol>
    </nav>

    @* --- ÜRÜN DETAY KARTI --- *@
    <div class="card border-0 shadow-sm rounded-5 overflow-hidden bg-white mb-5">
        <div class="row g-0">
            @* Ürün Resmi ve Favori Butonu *@
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center p-5 position-relative">
                <img src="@Model.Image" class="img-fluid rounded-4 shadow-sm" alt="@Model.Name"
                     style="max-height: 500px; width: 100%; object-fit: contain; transition: transform 0.5s ease;">

                <div class="position-absolute top-0 start-0 m-4">
                    <a asp-controller="Wishlist" asp-action="AddToWishlist" asp-route-id="@Model.Id"
                       class="btn btn-white shadow rounded-circle p-3 wishlist-btn-lg"
                       style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background: white; border:none;">
                        @if (wishlistIds.Contains(Model.Id))
                        {
                            <i class="fas fa-heart fs-4 text-danger"></i>
                        }
                        else
                        {
                            <i class="far fa-heart fs-4 text-danger"></i>
                        }
                    </a>
                </div>
            </div>

            @* Ürün Bilgileri *@
            <div class="col-md-6 p-5 d-flex flex-column justify-content-center">
                <div class="mb-2">
                    <span class="badge px-3 py-2 rounded-pill fw-bold" style="background: #eef2ff; color: #3b82f6;">
                        @Model.Brand?.Name
                    </span>
                </div>
                <h1 class="display-5 fw-extra-bold text-dark mb-3">@Model.Name</h1>

                <div class="d-flex align-items-center mb-4">
                    <span class="h2 fw-extra-bold text-primary mb-0 me-3">@Model.Price.ToString("C2")</span>
                    @if (Model.Stock > 0)
                    {
                        <span class="badge px-3 py-2 rounded-pill" style="background: #ecfdf5; color: #10b981;">
                            <i class="fas fa-check-circle me-1"></i> Stokta Var (@Model.Stock)
                        </span>
                    }
                    else
                    {
                        <span class="badge px-3 py-2 rounded-pill" style="background: #fee2e2; color: #ef4444;">
                            <i class="fas fa-times-circle me-1"></i> Stokta Yok
                        </span>
                    }
                </div>

                <p class="text-muted mb-5 fs-5 lead" style="text-align: justify;">@Model.Description</p>

                <div class="d-grid gap-3">
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id"
                       class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow @(Model.Stock <= 0 ? "disabled" : "")">
                        <i class="fas fa-cart-plus me-2"></i> Sepete Ekle
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill fw-bold py-3 text-muted border border-1">
                        <i class="fas fa-arrow-left me-2"></i> Alışverişe Devam Et
                    </a>
                </div>

                @* İkonlu Özellikler *@
                <div class="mt-5 pt-5 border-top">
                    <div class="row text-center g-4 text-primary">
                        <div class="col-4">
                            <i class="fas fa-truck mb-2 fs-4"></i>
                            <p class="small fw-bold mb-0 text-dark">Hızlı Teslimat</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-shield-alt mb-2 fs-4"></i>
                            <p class="small fw-bold mb-0 text-dark">Orijinal Ürün</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-undo mb-2 fs-4"></i>
                            <p class="small fw-bold mb-0 text-dark">Kolay İade</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- YORUMLAR BÖLÜMÜ --- *@
    <div class="mt-5 pt-5 border-top">
        <h3 class="fw-extra-bold text-dark mb-4">Müşteri Yorumları (@(Model.Comments?.Count ?? 0))</h3>

        <div class="row g-4">
            <div class="col-lg-8">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments.OrderByDescending(x => x.CreatedDate))
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-3 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-primary mb-0">@(comment.User?.UserName ?? "Kullanıcı")</h6>
                                <small class="text-muted small">@comment.CreatedDate.ToString("dd.MM.yyyy")</small>
                            </div>
                            <p class="mb-0 small text-secondary">@comment.Content</p>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light rounded-4 border-0 shadow-sm p-4">
                        <i class="fas fa-comment-dots me-2 text-primary"></i> Bu ürün için henüz yorum yapılmamış. İlk yorumu siz yapın!
                    </div>
                }
            </div>

            @* Yorum Yapma Formu *@
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3">Yorum Yap</h5>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="AddComment" method="post">
                            <input type="hidden" name="ProductId" value="@Model.Id" />
                            <div class="mb-3">
                                <textarea name="Content" class="form-control rounded-4 bg-light border-0 shadow-none"
                                      rows="4" placeholder="Ürün hakkındaki düşüncelerinizi yazın..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Gönder</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="small text-muted mb-3">Yorum yapabilmek için giriş yapmalısınız.</p>
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm rounded-pill px-4">Giriş Yap</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* --- İLİŞKİLİ ÜRÜNLER --- *@
    @if (ViewBag.RelatedProducts != null && ((IEnumerable<UrunSatisPortali.Models.Product>)ViewBag.RelatedProducts).Any())
    {
        <div class="mt-5 pt-5 border-top">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="fw-extra-bold text-dark m-0">İlginizi Çekebilecek <span class="text-primary text-gradient">Diğer Ürünler</span></h3>
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-link text-decoration-none fw-bold text-primary">Tümünü Gör →</a>
            </div>

            <div class="row g-4">
                @foreach (var related in (IEnumerable<UrunSatisPortali.Models.Product>)ViewBag.RelatedProducts)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 product-card-sm overflow-hidden bg-white">
                            <div class="position-relative p-3">
                                <img src="@related.Image" class="card-img-top rounded-4" alt="@related.Name"
                                     style="height: 180px; object-fit: contain;">

                                <div class="position-absolute top-0 start-0 m-2">
                                    <a asp-controller="Wishlist" asp-action="AddToWishlist" asp-route-id="@related.Id"
                                       class="btn btn-white shadow-sm rounded-circle p-1 text-danger"
                                       style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background:white; border:none;">
                                        @if (wishlistIds.Contains(related.Id))
                                        {
                                            <i class="fas fa-heart" style="font-size: 0.8rem;"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-heart" style="font-size: 0.8rem;"></i>
                                        }
                                    </a>
                                </div>
                            </div>
                            <div class="card-body p-3 text-center">
                                <h6 class="fw-bold mb-2 text-dark text-truncate small">@related.Name</h6>
                                <p class="text-primary fw-extra-bold mb-3 small">@related.Price.ToString("C2")</p>
                                <a asp-action="Details" asp-route-id="@related.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">İncele</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .text-gradient {
        background: linear-gradient(to right, #60a5fa, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .wishlist-btn-lg {
        transition: all 0.3s ease;
    }

        .wishlist-btn-lg:hover {
            transform: scale(1.1);
            color: #dc2626 !important;
        }

    .product-card-sm {
        transition: all 0.3s ease;
        border: 1px solid transparent !important;
    }

        .product-card-sm:hover {
            transform: translateY(-5px);
            border-color: #eef2ff !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "•";
        color: #cbd5e1;
    }

    .form-control:focus {
        background-color: #f1f5f9 !important;
    }
</style>