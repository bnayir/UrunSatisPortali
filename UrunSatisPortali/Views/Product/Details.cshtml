@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@model UrunSatisPortali.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Name + " - Ürün Detayı";

    var wishlistJson = Context.Session.GetString("WishlistSession");
    var wishlistIds = wishlistJson != null
        ? JsonConvert.DeserializeObject<List<UrunSatisPortali.Models.Product>>(wishlistJson).Select(x => x.Id).ToList()
        : new List<int>();

    // Ortalama Puan Hesaplama
    double averageRating = Model.Comments != null && Model.Comments.Any()
        ? Model.Comments.Average(x => x.Rating)
        : 0;
}

<div class="container py-5">
    @* --- BREADCRUMB --- *@
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">Anasayfa</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted small">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active text-primary fw-bold small" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    @* --- ÜRÜN DETAY KARTI --- *@
    <div class="card border-0 shadow-sm rounded-5 overflow-hidden bg-white mb-5">
        <div class="row g-0">
            <div class="col-md-6 bg-light d-flex align-items-center justify-content-center p-5 position-relative">
                <img src="@Model.Image" class="img-fluid rounded-4 shadow-sm main-product-img" alt="@Model.Name"
                     style="max-height: 500px; width: 100%; object-fit: contain; transition: transform 0.5s ease;">

                <div class="position-absolute top-0 start-0 m-4">
                    <a asp-controller="Wishlist" asp-action="AddToWishlist" asp-route-id="@Model.Id"
                       class="btn btn-white shadow rounded-circle p-3 wishlist-btn-lg"
                       style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background: white; border:none;">
                        @if (wishlistIds.Contains(Model.Id))
                        {
                            <i class="fas fa-heart fs-4 text-danger"></i>
                        }
                        else
                        {
                            <i class="far fa-heart fs-4 text-danger"></i>
                        }
                    </a>
                </div>
            </div>

            <div class="col-md-6 p-5 d-flex flex-column justify-content-center">
                <div class="mb-2 d-flex align-items-center gap-2">
                    <span class="badge px-3 py-2 rounded-pill fw-bold" style="background: #eef2ff; color: #3b82f6;">@Model.Brand?.Name</span>
                    @* ORTALAMA PUAN GÖSTERGESİ *@
                    <div class="text-warning small">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="@(i <= Math.Round(averageRating) ? "fas" : "far") fa-star"></i>
                        }
                        <span class="text-muted ms-1">(@averageRating.ToString("0.0"))</span>
                    </div>
                </div>

                <h1 class="display-5 fw-extra-bold text-dark mb-3">@Model.Name</h1>

                <div class="d-flex align-items-center mb-4">
                    <span class="h2 fw-extra-bold text-primary mb-0 me-3">@Model.Price.ToString("C2")</span>
                    @if (Model.Stock > 0)
                    {
                        <span class="badge px-3 py-2 rounded-pill" style="background: #ecfdf5; color: #10b981;">
                            <i class="fas fa-check-circle me-1"></i> Stokta Var (@Model.Stock)
                        </span>
                    }
                    else
                    {
                        <span class="badge px-3 py-2 rounded-pill" style="background: #fee2e2; color: #ef4444;">
                            <i class="fas fa-times-circle me-1"></i> Stokta Yok
                        </span>
                    }
                </div>

                <p class="text-muted mb-5 fs-5 lead" style="text-align: justify;">@Model.Description</p>

                <div class="d-grid gap-3">
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Id"
                       class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow @(Model.Stock <= 0 ? "disabled" : "")">
                        <i class="fas fa-cart-plus me-2"></i> Sepete Ekle
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill fw-bold py-3 text-muted border border-1">
                        <i class="fas fa-arrow-left me-2"></i> Alışverişe Devam Et
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* --- YORUMLAR BÖLÜMÜ --- *@
    <div class="row g-5">
        <div class="col-lg-8">
            <h3 class="fw-extra-bold text-dark mb-4">Müşteri Yorumları (@(Model.Comments?.Count ?? 0))</h3>
            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var comment in Model.Comments.OrderByDescending(x => x.CreatedDate))
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3 bg-white comment-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="fw-bold text-primary mb-0">@(comment.User?.UserName ?? "Kullanıcı")</h6>
                                @* YORUM PUANI *@
                                <div class="text-warning small mt-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= comment.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </div>
                            <small class="text-muted small">@comment.CreatedDate.ToString("dd.MM.yyyy")</small>
                        </div>
                        <p class="mb-0 small text-secondary">@comment.Content</p>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light rounded-4 border-0 shadow-sm p-4 text-muted">
                    <i class="fas fa-comment-dots me-2 text-primary"></i> İlk yorumu siz yapın!
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 100px;">
                <h5 class="fw-bold mb-3">Ürünü Değerlendir</h5>
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Product" asp-action="AddComment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.Id" />

                        @* İNTERAKTİF YILDIZ SEÇİMİ *@
                        <div class="mb-3 text-center">
                            <div class="rating-input text-warning fs-3 mb-2" style="cursor: pointer;">
                                <i class="fas fa-star star-option" data-value="1"></i>
                                <i class="fas fa-star star-option" data-value="2"></i>
                                <i class="fas fa-star star-option" data-value="3"></i>
                                <i class="fas fa-star star-option" data-value="4"></i>
                                <i class="fas fa-star star-option" data-value="5"></i>
                            </div>
                            <input type="hidden" name="Rating" id="selectedRating" value="5">
                            <p class="small text-muted" id="ratingText">Harika!</p>
                        </div>

                        <div class="mb-3">
                            <textarea name="Content" class="form-control rounded-4 bg-light border-0 shadow-none" rows="4" placeholder="Deneyiminizi paylaşın..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm py-2">Gönder</button>
                    </form>
                }
                else
                {
                    <div class="text-center py-3">
                        <p class="small text-muted mb-3">Değerlendirme yapabilmek için giriş yapmalısınız.</p>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm rounded-pill px-4">Giriş Yap</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* --- İLGİNİZİ ÇEKEBİLECEK ÜRÜNLER --- *@
    @if (ViewBag.RelatedProducts != null)
    {
        var relatedList = (IEnumerable<UrunSatisPortali.Models.Product>)ViewBag.RelatedProducts;
        if (relatedList.Any())
        {
            <div class="mt-5 pt-5 border-top">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h3 class="fw-extra-bold text-dark m-0">İlginizi Çekebilecek <span class="text-primary text-gradient">Diğer Ürünler</span></h3>
                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-link text-decoration-none fw-bold text-primary">Tümünü Gör →</a>
                </div>

                <div class="row g-4">
                    @foreach (var related in relatedList)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm rounded-4 product-card-sm overflow-hidden bg-white text-center p-3">
                                <a asp-action="Details" asp-route-id="@related.Id" class="text-decoration-none">
                                    <img src="@related.Image" class="img-fluid rounded-4 mb-3" alt="@related.Name" style="height: 180px; object-fit: contain;">
                                    <h6 class="fw-bold text-dark text-truncate small mb-1">@related.Name</h6>
                                    <p class="text-primary fw-extra-bold small mb-3">@related.Price.ToString("C2")</p>
                                </a>
                                <a asp-action="Details" asp-route-id="@related.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">İncele</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .text-gradient {
        background: linear-gradient(to right, #60a5fa, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .main-product-img:hover {
        transform: scale(1.05);
    }

    .product-card-sm {
        transition: 0.3s;
        border: 1px solid transparent !important;
    }

        .product-card-sm:hover {
            transform: translateY(-5px);
            border-color: #3b82f6 !important;
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .comment-card:hover {
        transform: translateX(5px);
        transition: 0.3s;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "•";
        color: #cbd5e1;
    }

    /* Yıldız Seçim Efekti */
    .star-option {
        transition: 0.2s;
    }

        .star-option:hover {
            transform: scale(1.2);
        }
</style>

@section Scripts {
    <script>
        // Yıldız Seçim Mantığı
        const stars = document.querySelectorAll('.star-option');
        const ratingInput = document.getElementById('selectedRating');
        const ratingText = document.getElementById('ratingText');
        const labels = ["Çok Kötü", "Kötü", "Normal", "İyi", "Harika!"];

        stars.forEach(star => {
            star.addEventListener('click', function() {
                const val = parseInt(this.getAttribute('data-value'));
                ratingInput.value = val;
                ratingText.innerText = labels[val - 1];

                stars.forEach((s, index) => {
                    if (index < val) {
                        s.classList.replace('far', 'fas');
                        s.style.color = "#ffc107";
                    } else {
                        s.classList.replace('fas', 'far');
                        s.style.color = "#cbd5e1";
                    }
                });
            });
        });
    </script>
}