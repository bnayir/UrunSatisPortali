@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@model IEnumerable<UrunSatisPortali.Models.Product>

@{
    // Favori kontrolü için session'dan listeyi alıyoruz
    var wishlistJson = Context.Session.GetString("WishlistSession");
    var wishlistIds = wishlistJson != null
        ? JsonConvert.DeserializeObject<List<UrunSatisPortali.Models.Product>>(wishlistJson).Select(x => x.Id).ToList()
        : new List<int>();
}

<div class="container py-5">
    @* --- ÜST BANNER --- *@
    <div class="position-relative overflow-hidden p-5 mb-5 rounded-5 text-white shadow-lg"
         style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%);">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-md-7">
                <span class="badge bg-primary mb-3 px-3 py-2 rounded-pill fw-bold shadow-sm">YENİ SEZON</span>
                <h1 class="display-3 fw-extra-bold mb-3 tracking-tight">Güzelliğinizi <span class="text-primary text-gradient">Yeniden Tanımlayın</span></h1>
                <p class="lead text-white-50 mb-4">Lüks parfümler ve profesyonel kozmetik ürünleri.</p>
                <div class="d-flex gap-3">
                    <a href="#urunler" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold shadow">Hemen Keşfet</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4" id="urunler">
        @* --- SOL FİLTRE PANELİ --- *@
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top" style="top: 100px;">
                <h6 class="fw-bold mb-3 d-flex align-items-center text-uppercase small ls-1">
                    <i class="fas fa-bars-staggered me-2 text-primary"></i>Kategoriler
                </h6>
                <div class="nav flex-column nav-pills custom-pills">
                    <a asp-action="Index" asp-controller="Home"
                       class="nav-link mb-2 rounded-pill text-start @(ViewBag.ActiveCategory == null ? "active" : "text-dark")">
                        <i class="fas fa-border-all me-2"></i>Tümü
                    </a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<UrunSatisPortali.Models.Category>)ViewBag.Categories)
                        {
                            <a asp-action="Index" asp-controller="Home" asp-route-categoryId="@cat.Id"
                               class="nav-link mb-2 rounded-pill text-start @(ViewBag.ActiveCategory == cat.Id ? "active" : "text-dark")">
                                <i class="fas fa-tag me-2"></i>@cat.Name
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        @* --- ANA ÜRÜN VİTRİNİ --- *@
        <div class="col-lg-9">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 product-card overflow-hidden bg-white">
                            <div class="position-relative">
                                <img src="@item.Image" class="card-img-top p-4 rounded-5" alt="@item.Name"
                                     style="height: 280px; object-fit: contain;">

                                @* STOK DURUMU ROZETİ *@
                                @if (item.Stock <= 0)
                                {
                                    <div class="position-absolute top-50 start-50 translate-middle w-100 text-center">
                                        <span class="badge bg-danger px-3 py-2 shadow-lg rounded-pill opacity-90 fw-bold">TÜKENDİ</span>
                                    </div>
                                }

                                <div class="position-absolute top-0 start-0 m-3">
                                    <a asp-controller="Wishlist" asp-action="AddToWishlist" asp-route-id="@item.Id"
                                       class="btn btn-white shadow-sm rounded-circle p-2 wishlist-btn" style="background:white; border:none;">
                                        @if (wishlistIds.Contains(item.Id))
                                        {
                                            <i class="fas fa-heart text-danger"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-heart text-danger"></i>
                                        }
                                    </a>
                                </div>
                            </div>
                            <div class="card-body p-4 text-center">
                                <p class="text-muted small fw-bold mb-1">@item.Brand?.Name</p>
                                <h5 class="fw-bold mb-2 text-dark text-truncate">@item.Name</h5>

                                @* SATIŞ VE STOK BİLGİSİ *@
                                <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                                    <span class="text-muted small"><i class="fas fa-fire text-danger me-1"></i>@item.SalesCount Satıldı</span>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="text-success small fw-bold">Stok: @item.Stock</span>
                                    }
                                </div>

                                <div class="mb-3">
                                    <span class="h4 fw-extra-bold text-primary mb-0">@item.Price.ToString("C2")</span>
                                </div>

                                <div class="d-grid gap-2">
                                    @* STOK KONTROLÜNE GÖRE BUTON DURUMU *@
                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id"
                                       class="btn btn-primary rounded-pill py-2 fw-bold shadow-sm @(item.Stock <= 0 ? "disabled" : "")">
                                        <i class="fas fa-shopping-basket me-2"></i>@(item.Stock <= 0 ? "Stokta Yok" : "Sepete Ekle")
                                    </a>

                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-light rounded-pill py-2 text-muted fw-bold border-0">
                                        Detayları İncele
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* --- İLGİNİZİ ÇEKEBİLECEK ÜRÜNLER BÖLÜMÜ --- *@
            @if (ViewBag.SuggestedProducts != null)
            {
                <div class="mt-5 pt-5 border-top">
                    <h4 class="fw-bold text-dark mb-4"><i class="fas fa-magic text-primary me-2"></i>İlginizi Çekebilecek <span class="text-primary">Diğer Ürünler</span></h4>
                    <div class="row g-4">
                        @foreach (var sug in (IEnumerable<UrunSatisPortali.Models.Product>)ViewBag.SuggestedProducts)
                        {
                            <div class="col-md-3">
                                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 suggestion-card">
                                    <a asp-action="Details" asp-controller="Product" asp-route-id="@sug.Id" class="text-decoration-none">
                                        <img src="@sug.Image" class="img-fluid mb-2" style="height: 120px; object-fit: contain;">
                                        <h6 class="fw-bold text-dark small text-truncate">@sug.Name</h6>
                                        <span class="text-primary fw-bold small">@sug.Price.ToString("C2")</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .product-card {
        transition: all 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
        }
        /* Stokta olmayan ürünleri solduran efekt */
        .product-card.disabled-style {
            opacity: 0.7;
        }

    .suggestion-card {
        transition: 0.3s;
        border: 1px solid transparent !important;
    }

        .suggestion-card:hover {
            border-color: #3b82f6 !important;
            transform: scale(1.05);
        }

    .text-gradient {
        background: linear-gradient(to right, #60a5fa, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .btn-light:hover {
        background-color: #e2e8f0 !important;
        color: #1e293b !important;
    }
</style>