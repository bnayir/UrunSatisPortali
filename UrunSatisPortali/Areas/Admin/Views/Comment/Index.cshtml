@model IEnumerable<UrunSatisPortali.Models.Comment>

<div class="container-fluid pt-4 px-4">
    <div class="bg-light text-center rounded p-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0 text-primary fw-bold"><i class="fas fa-comments me-2"></i>Tüm Yorumlar ve Değerlendirmeler</h6>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead>
                    <tr class="text-dark bg-white">
                        <th>Kullanıcı</th>
                        <th>Ürün</th>
                        <th style="width: 120px;">Puan</th> @* Yeni Sütun *@
                        <th>Yorum</th>
                        <th>Tarih</th>
                        <th style="width: 100px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="fw-bold">@item.User?.UserName</td>
                            <td><span class="badge bg-info text-dark">@item.Product?.Name</span></td>
                            <td>
                                @* YILDIZ GÖSTERİMİ *@
                                <div class="text-warning text-nowrap">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= item.Rating ? "fas" : "far") fa-star small"></i>
                                    }
                                    <span class="text-muted ms-1 small">(@item.Rating)</span>
                                </div>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 250px;" title="@item.Content">
                                    @item.Content
                                </div>
                            </td>
                            <td>@item.CreatedDate.ToShortDateString()</td>
                            <td>
                                <button onclick="deleteComment(@item.Id)" class="btn btn-sm btn-outline-danger shadow-sm">
                                    <i class="fas fa-trash me-1"></i> Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function deleteComment(id) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu yorum kalıcı olarak silinecektir!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'İptal',
            background: '#fff',
            customClass: {
                confirmButton: 'rounded-pill px-4',
                cancelButton: 'rounded-pill px-4'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/Comment/Delete/' + id,
                    type: 'POST',
                    success: function (data) {
                        if (data.success) {
                            $("#row-" + id).fadeOut(500, function() {
                                $(this).remove();
                            });
                            Swal.fire({
                                icon: 'success',
                                title: 'Silindi!',
                                text: 'Yorum ve değerlendirme başarıyla silindi.',
                                timer: 2000,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire('Hata!', 'Yorum silinemedi.', 'error');
                        }
                    }
                });
            }
        })
    }
</script>

<style>
    .table thead th {
        border-top: none;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .text-warning {
        color: #ffc107 !important;
    }
</style>