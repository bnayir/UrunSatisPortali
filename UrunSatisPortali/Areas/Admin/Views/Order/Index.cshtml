@model IEnumerable<UrunSatisPortali.Models.Order>

@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-white rounded-4 p-4 shadow-sm border">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="fas fa-shopping-cart text-primary me-2"></i>Sipariş Yönetimi
            </h5>
            <span class="badge bg-primary rounded-pill px-3 py-2">Toplam @Model.Count() Sipariş</span>
        </div>

        <div class="table-responsive">
            <table class="table text-start align-middle table-hover mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase bg-light">
                        <th class="p-3">Müşteri</th>
                        <th class="p-3">Tarih</th>
                        <th class="p-3">Tutar</th>
                        <th class="p-3">Şehir</th>
                        <th class="p-3" style="min-width: 280px;">Sipariş Durumu</th>
                        <th class="p-3 text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-soft-primary p-2 me-2 text-primary">
                                        <i class="fas fa-user small"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@(item.User?.UserName ?? "Misafir")</span>
                                </div>
                            </td>
                            <td class="p-3 small text-muted">@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="p-3 fw-bold text-primary">@item.TotalPrice.ToString("C2")</td>
                            <td class="p-3 text-muted">@item.City</td>
                            <td class="p-3">
                                @* --- DURUM GÜNCELLEME FORMU --- *@
                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <select name="status" class="form-select form-select-sm border-0 bg-light rounded-pill px-3 shadow-none">
                                        <option value="Sipariş Alındı" selected="@(item.Status == "Sipariş Alındı")">Sipariş Alındı</option>
                                        <option value="Hazırlanıyor" selected="@(item.Status == "Hazırlanıyor")">Hazırlanıyor</option>
                                        <option value="Kargoya Verildi" selected="@(item.Status == "Kargoya Verildi")">Kargoya Verildi</option>
                                        <option value="Teslim Edildi" selected="@(item.Status == "Teslim Edildi")">Teslim Edildi</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-circle p-2" title="Güncelle">
                                        <i class="fas fa-check small"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="p-3 text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-none">
                                    <i class="fas fa-search me-1"></i> Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: #eef2ff;
    }

    .table tbody tr:hover {
        background-color: #fbfcfe !important;
        transition: 0.2s ease;
    }

    .form-select-sm {
        cursor: pointer;
        font-size: 0.85rem;
    }

    .btn-primary.rounded-circle {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>