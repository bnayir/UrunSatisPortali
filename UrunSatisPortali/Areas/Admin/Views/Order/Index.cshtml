@model IEnumerable<UrunSatisPortali.Models.Order>

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-dark text-white p-3">
            <h5 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Tüm Siparişler</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Müşteri</th>
                        <th>Tarih</th>
                        <th>Toplam Tutar</th>
                        <th>Şehir</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-bold text-primary">@item.TotalPrice.ToString("C2")</td>
                            <td>@item.City</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill">
                                    Detayları Gör
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>