@model UrunSatisPortali.Models.Product

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 text-center">
            <img src="@Model.Image" class="img-fluid rounded shadow-lg" alt="@Model.Name" style="max-height: 400px; object-fit: contain;">
        </div>
        <div class="col-md-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item text-primary fw-bold">@Model.Brand?.Name</li>
                    <li class="breadcrumb-item active">@Model.Category?.Name</li>
                </ol>
            </nav>
            <h1 class="display-5 fw-bold text-dark">@Model.Name</h1>
            <h3 class="text-primary mb-4 fw-bold">@Model.Price.ToString("C2")</h3>
            <p class="text-muted border-start border-4 ps-3">@Model.Description</p>
            <hr />
            <div class="d-flex align-items-center">
                <span class="badge bg-success p-2 me-2">Stokta Var</span>
                <p class="mb-0"><strong>Stok Durumu:</strong> @Model.Stock adet</p>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row justify-content-center">
        <div class="col-md-10">
            <h4 class="mb-4 fw-bold"><i class="fas fa-comments me-2"></i>Yorumlar (@(Model.Comments?.Count() ?? 0))</h4>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="card my-4 shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3">Düşüncelerinizi Paylaşın</h6>
                        @* ASP-AREA="" EKLEMESİ KRİTİKTİR *@
                        <form asp-area="" asp-controller="Comment" asp-action="AddComment" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="form-group mb-3">
                                <textarea name="content" class="form-control border-0 shadow-sm" rows="3" required placeholder="Ürün hakkında ne düşünüyorsunuz?"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow">Gönder</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning border-0 shadow-sm">
                    <i class="fas fa-info-circle me-2"></i>Yorum yapabilmek için lütfen <a asp-area="Identity" asp-page="/Account/Login" class="fw-bold">giriş yapın</a>.
                </div>
            }

            <div class="comment-list mt-4">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedDate))
                    {
                        <div class="card mb-3 border-0 shadow-sm rounded-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-primary">
                                        <i class="fas fa-user-circle me-1"></i> @(comment.User?.UserName ?? "Anonim Kullanıcı")
                                    </span>
                                    <small class="text-muted">@comment.CreatedDate.ToString("dd MMMM yyyy")</small>
                                </div>
                                <p class="mb-0 text-dark">@comment.Content</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-comment-slash fa-3x text-light mb-3"></i>
                        <p class="text-muted">Henüz yorum yapılmamış. İlk yorumu sen yap!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>