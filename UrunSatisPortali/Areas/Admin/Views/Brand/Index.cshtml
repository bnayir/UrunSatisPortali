@model IEnumerable<UrunSatisPortali.Models.Brand>

<div class="container-fluid mt-4">
    <h2>Marka Listesi</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">Yeni Marka Ekle</a>
    <table class="table table-bordered bg-white shadow-sm">
        <thead class="bg-light">
            <tr>
                <th>Marka Adı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <a class="btn btn-sm btn-warning">Düzenle</a>
                        <a class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>