@model IEnumerable<UrunSatisPortali.Models.Brand>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Marka Yönetimi";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-white rounded-4 shadow-sm p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-tags me-2 text-primary"></i>Marka Listesi</h6>
            <a asp-area="Admin" asp-controller="Brand" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-plus me-2"></i>Yeni Marka Ekle
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-dark">
                    <tr>
                        <th class="border-0">Marka Adı</th>
                        <th class="border-0 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium text-dark">@item.Name</td>
                            <td class="text-end">
                                @* DÜZENLE BUTONU *@
                                <a asp-area="Admin" asp-controller="Brand" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning rounded-pill px-3 me-1">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>

                                @* SİL BUTONU *@
                                <a asp-area="Admin" asp-controller="Brand" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                   onclick="return confirm('@item.Name markasını silmek istediğinize emin misiniz?')">
                                    <i class="fas fa-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>