@model UrunSatisPortali.Models.Brand
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Marka Düzenle";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4 justify-content-center">
        <div class="col-sm-12 col-xl-6">
            <div class="bg-white rounded-4 shadow-sm p-4">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-edit me-2 text-primary"></i>Markayı Düzenle</h6>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" /> @* Bu satır çok önemli! *@

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold small">Marka Adı</label>
                        <input asp-for="Name" class="form-control rounded-pill border-light bg-light shadow-none" required>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Güncelle</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>