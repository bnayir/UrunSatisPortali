@model IEnumerable<UrunSatisPortali.Models.Product>

<div class="container-fluid pt-4 px-4">
    @* Üst Kartlar - Sayaçlar *@
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-shopping-cart fa-3x opacity-50"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold">Toplam Ürün</p>
                        <h2 class="mb-0 fw-extra-bold">@ViewBag.ProductCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-th-list fa-3x opacity-50"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold">Kategoriler</p>
                        <h2 class="mb-0 fw-extra-bold">@ViewBag.CategoryCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-award fa-3x opacity-50"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold">Markalar</p>
                        <h2 class="mb-0 fw-extra-bold">@ViewBag.BrandCount</h2>
                    </div>
                </div>
            </div>
        </div>
        @* SIGNALR'IN GÜNCELLEYECEĞİ YORUM KARTI *@
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-danger text-white h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-comments fa-3x opacity-50"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold">Yorumlar</p>
                        @* ID BURAYA EKLENDİ *@
                        <h2 id="commentCount" class="mb-0 fw-extra-bold">@ViewBag.CommentCount</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Grafik ve Tablo Alanları *@
    <div class="row g-4 mb-4">
        <div class="col-sm-12 col-xl-8">
            <div class="bg-white rounded-4 p-4 shadow-sm border-0 dashboard-main-card">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-chart-pie me-2 text-primary"></i>Kategori Analizi</h6>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="col-sm-12 col-xl-4">
            <div class="bg-white rounded-4 p-4 shadow-sm border-0 dashboard-main-card overflow-auto">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-history me-2 text-primary"></i>Son Ürünler</h6>
                <table class="table table-borderless table-hover align-middle small">
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-end text-primary fw-bold">@item.Price.ToString("N2") ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    .dashboard-main-card {
        height: 400px;
    }

    .card:hover {
        transform: translateY(-5px);
        transition: 0.3s;
    }
</style>

@section Scripts {
    @* Kütüphaneler *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        // 1. Chart.js Grafikleri
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoryCounts)),
                    backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b']
                }]
            },
            options: { cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });

        // 2. SignalR Bağlantısı (Tek ve Temiz Blok)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/dashboardHub")
            .build();

        connection.on("ReceiveCommentCount", function (count) {
            // Sayacı Güncelle
            const counter = document.getElementById("commentCount");
            if (counter) {
                counter.innerText = count;
                // Görsel Efekt
                counter.classList.add("text-warning");
                setTimeout(() => counter.classList.remove("text-warning"), 2000);
            }

            // Canlı Bildirim (SweetAlert)
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'info',
                title: 'Yeni bir yorum geldi!',
                showConfirmButton: false,
                timer: 3000
            });
        });

        connection.start().catch(err => console.error("SignalR Hatası: ", err));

        // 3. Stok Uyarıları
        @foreach (var item in ViewBag.TopProducts)
        {
                if (item.Stock < 5)
                {
                        <text>
                        Swal.fire({
                            toast: true,
                            position: 'bottom-start',
                            icon: 'warning',
                            title: '@item.Name stoğu: @item.Stock',
                            showConfirmButton: false,
                            timer: 5000
                        });
                        </text>
                }
        }
    </script>
}