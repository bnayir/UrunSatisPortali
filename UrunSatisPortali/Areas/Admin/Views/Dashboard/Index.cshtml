@using UrunSatisPortali.Models
@model IEnumerable<Product>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Yönetim Paneli";

    var totalSales = ViewBag.TotalSales ?? 0.0;
    var orderCount = ViewBag.OrderCount ?? 0;
    var userCount = ViewBag.UserCount ?? 0;
    var messageCount = ViewBag.NewMessagesCount ?? 0;
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white">
                <div class="icon-circle bg-light text-primary" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f3ff;">
                    <i class="fa fa-chart-line fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Toplam Satış</p>
                    @* ID'ler JavaScript tarafından kontrol edilecek *@
                    <h4 id="totalSalesText" class="mb-0 fw-bold">@totalSales.ToString("C2")</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white">
                <div class="icon-circle bg-light text-success" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0fff4;">
                    <i class="fa fa-shopping-basket fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Siparişler</p>
                    <h4 id="orderCountText" class="mb-0 fw-bold">@orderCount</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white">
                <div class="icon-circle bg-light text-info" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e6f7ff;">
                    <i class="fa fa-users fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Müşteriler</p>
                    <h4 class="mb-0 fw-bold">@userCount</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white">
                <div class="icon-circle bg-light text-warning" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fffaf0;">
                    <i class="fa fa-envelope fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Yeni Mesaj</p>
                    <h4 class="mb-0 fw-bold">@messageCount</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-chart-pie me-2 text-primary"></i>Kategori Bazlı Ürün Dağılımı</h6>
                <div style="height: 300px; position: relative;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 text-center">
                <h6 class="mb-4 fw-bold text-dark text-start"><i class="fas fa-server me-2 text-primary"></i>Sistem Durumu</h6>
                <div class="py-4">
                    <div class="h1 fw-bold text-primary mb-1">OK</div>
                    <p class="text-muted small">Sistem SignalR ile izleniyor.</p>
                    <div class="progress rounded-pill" style="height: 10px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* Sürüm 6.0.1 kullanıyoruz, 8.0 yüklemiyoruz *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        // Sayfa tamamen yüklendiğinde grafiği ve tüneli başlat
        window.onload = function() {

            // --- 1. SIGNALR BAĞLANTISI ---
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/dashboardHub")
                .build();

            connection.on("ReceiveOrderUpdate", function (newOrderCount, newTotalSales) {
                // Sayfayı yenilemeden rakamları güncelle
                const orderEl = document.getElementById("orderCountText");
                const salesEl = document.getElementById("totalSalesText");

                if (orderEl) orderEl.innerText = newOrderCount;
                if (salesEl) salesEl.innerText = newTotalSales;

                console.log("Anlık Güncelleme Başarılı: " + newOrderCount);
            });

            connection.start()
                .then(() => console.log("SignalR Bağlantısı Kuruldu."))
                .catch(err => console.error("SignalR Hatası: " + err.toString()));

            // --- 2. GRAFİK ÇİZİMİ ---
            const canvas = document.getElementById("categoryChart");
            if (canvas) {
                const ctx = canvas.getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels ?? new string[] { "Yükleniyor" })),
                        datasets: [{
                            data: @Html.Raw(Json.Serialize(ViewBag.CategoryCounts ?? new int[] { 1 })),
                            backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        };
    </script>
}