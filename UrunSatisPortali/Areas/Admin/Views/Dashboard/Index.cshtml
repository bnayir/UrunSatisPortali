@model IEnumerable<UrunSatisPortali.Models.Product>

<div class="container-fluid pt-4 px-4">
    @* 1. SATIR: İstatistik Kartları (Modern & Gradient) *@
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-shopping-cart fa-3x opacity-25"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold opacity-75 small uppercase">Toplam Ürün</p>
                        <h2 class="mb-0 fw-bold">@ViewBag.ProductCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-th-list fa-3x opacity-25"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold opacity-75 small uppercase">Kategoriler</p>
                        <h2 class="mb-0 fw-bold">@ViewBag.CategoryCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color: white;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-award fa-3x opacity-25"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold opacity-75 small uppercase">Markalar</p>
                        <h2 class="mb-0 fw-bold">@ViewBag.BrandCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <i class="fas fa-comments fa-3x opacity-25"></i>
                    <div class="text-end">
                        <p class="mb-1 fw-bold opacity-75 small uppercase">Yorumlar</p>
                        <h2 id="commentCount" class="mb-0 fw-bold">@ViewBag.CommentCount</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* 2. SATIR: Grafik ve Liste *@
    <div class="row g-4 mb-4">
        <div class="col-sm-12 col-xl-8">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-4">
                <h6 class="mb-4 fw-bold text-dark d-flex align-items-center">
                    <span class="p-2 bg-primary-soft rounded-3 me-2" style="background: #eef2ff; color: #6366f1;">
                        <i class="fas fa-chart-pie"></i>
                    </span> Kategori Dağılım Analizi
                </h6>
                <canvas id="categoryChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
        <div class="col-sm-12 col-xl-4">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-4 overflow-auto" style="max-height: 400px;">
                <h6 class="mb-4 fw-bold text-dark d-flex align-items-center">
                    <span class="p-2 bg-success-soft rounded-3 me-2" style="background: #ecfdf5; color: #10b981;">
                        <i class="fas fa-history"></i>
                    </span> Son Eklenenler
                </h6>
                <table class="table table-hover table-borderless">
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-dark py-2">@item.Name</td>
                                <td class="text-end text-primary fw-bold">@item.Price.ToString("N2") ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* 3. SATIR: En Çok Satanlar & Satış Analizi *@
    <div class="row g-4 mb-4">
        <div class="col-sm-12 col-xl-7">
            <div class="card border-0 rounded-4 shadow-sm p-4 overflow-auto" style="min-height: 400px;">
                <h6 class="mb-4 fw-bold text-dark d-flex align-items-center">
                    <span class="p-2 bg-warning-soft rounded-3 me-2" style="background: #fffbeb; color: #f59e0b;">
                        <i class="fas fa-trophy"></i>
                    </span> En Çok Satan Ürünler
                </h6>
                <table class="table align-middle">
                    <thead class="text-muted small uppercase">
                        <tr>
                            <th>Ürün</th>
                            <th>Satış</th>
                            <th>Stok</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.TopProducts)
                        {
                            <tr>
                                <td class="fw-bold">@item.Name</td>
                                <td><span class="badge rounded-pill" style="background: #d1e7dd; color: #065f46;">@item.TotalSales Adet</span></td>
                                <td class="text-muted">@item.Stock</td>
                                <td>
                                    @if (item.Stock < 10)
                                    {
                                        <span class="badge bg-danger-soft text-danger px-3 py-2 rounded-pill" style="background: #fee2e2;">Kritik</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill" style="background: #d1e7dd;">Yeterli</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-sm-12 col-xl-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
                <h6 class="mb-4 fw-bold text-dark d-flex align-items-center">
                    <span class="p-2 bg-info-soft rounded-3 me-2" style="background: #e0f2fe; color: #0ea5e9;">
                        <i class="fas fa-chart-bar"></i>
                    </span> Kategori Bazlı Satış
                </h6>
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f1f5f9;
    }

    .card {
        transition: transform 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .badge {
        font-weight: 600;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/lib/microsoft/signalr/dist/browser/signalr.js"></script>

    <script>
        // 1. Doughnut Chart
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoryCounts)),
                    backgroundColor: ['#6366f1', '#10b981', '#0ea5e9', '#f59e0b', '#ef4444'],
                    borderWidth: 0,
                    hoverOffset: 20
                }]
            },
            options: { cutout: '80%', plugins: { legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true } } } }
        });

        // 2. Bar Chart
        new Chart(document.getElementById('salesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategorySalesLabels)),
                datasets: [{
                    label: 'Satış',
                    data: @Html.Raw(Json.Serialize(ViewBag.CategorySalesCounts)),
                    backgroundColor: '#6366f1',
                    borderRadius: 8
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { display: false } }, x: { grid: { display: false } } } }
        });

        // 3. SignalR
        const connection = new signalR.HubConnectionBuilder().withUrl("/dashboardHub").build();
        connection.on("ReceiveCommentCount", (count) => {
            const counter = document.getElementById("commentCount");
            if (counter) {
                counter.innerText = count;
                counter.style.transform = "scale(1.2)";
                setTimeout(() => counter.style.transform = "scale(1)", 500);
            }
            Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: 'Yeni yorum!', showConfirmButton: false, timer: 3000 });
        });
        connection.start().catch(err => console.error(err));

        // 4. Stok Uyarıları
        @foreach (var item in ViewBag.TopProducts)
        {
                if (item.Stock < 5)
                {
                        <text>
                        Swal.fire({ toast: true, position: 'bottom-end', icon: 'warning', title: '@item.Name stok kritik!', showConfirmButton: false, timer: 4000 });
                        </text>
                }
        }
    </script>
}