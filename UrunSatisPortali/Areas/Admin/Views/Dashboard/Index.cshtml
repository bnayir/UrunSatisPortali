@using UrunSatisPortali.Models
@model IEnumerable<Product>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; // Layout yolunu projenle eşleştirdik
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container-fluid pt-4 px-4">
    @* --- ÜST ÖZET KARTLARI --- *@
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white card-hover">
                <div class="icon-circle bg-primary-soft text-primary">
                    <i class="fa fa-chart-line fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Toplam Satış</p>
                    <h4 class="mb-0 fw-extra-bold text-dark">@ViewBag.TotalSales.ToString("C2")</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white card-hover">
                <div class="icon-circle bg-success-soft text-success">
                    <i class="fa fa-shopping-basket fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Siparişler</p>
                    <h4 class="mb-0 fw-extra-bold text-dark">@ViewBag.OrderCount</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white card-hover">
                <div class="icon-circle bg-info-soft text-info">
                    <i class="fa fa-users fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Müşteriler</p>
                    <h4 class="mb-0 fw-extra-bold text-dark">@ViewBag.UserCount</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white card-hover">
                <div class="icon-circle bg-warning-soft text-warning">
                    <i class="fa fa-envelope fa-2x"></i>
                </div>
                <div class="text-end">
                    <p class="mb-1 text-muted small fw-bold text-uppercase">Yeni Mesaj</p>
                    <h4 class="mb-0 fw-extra-bold text-warning">@ViewBag.NewMessagesCount</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        @* --- GRAFİK ALANI: KATEGORİ DAĞILIMI --- *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-chart-pie me-2 text-primary"></i>Kategori Bazlı Ürün Dağılımı</h6>
                </div>
                <div class="chart-area" style="height: 300px;">
                    <canvas id="categoryChart"></canvas> @* ID burası ile eşleşmeli *@
                </div>
            </div>
        </div>

        @* --- HIZLI ANALİZ: EN POPÜLER ÜRÜNLER --- *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-fire me-2 text-danger"></i>En Popüler 5 Ürün</h6>
                <div class="list-group list-group-flush">
                    @foreach (var item in (dynamic)ViewBag.TopProducts)
                    {
                        <div class="list-group-item bg-transparent border-0 px-0 mb-3 d-flex align-items-center">
                            <div class="rounded-3 bg-light p-2 me-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-box text-muted"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 small fw-bold text-dark">@item.Name</h6>
                                <span class="text-muted" style="font-size: 0.7rem;">@item.TotalSales Satış</span>
                            </div>
                            <span class="badge bg-primary-soft text-primary rounded-pill small">@item.Price.ToString("C0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* --- SON GELEN 5 MESAJ --- *@
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Son Mesajlar</h6>
                    <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="btn btn-sm btn-light rounded-pill px-3 fw-bold small">Tümünü Gör</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <tbody>
                            @foreach (var msg in (IEnumerable<Message>)ViewBag.RecentMessages)
                            {
                                <tr>
                                    <td style="width: 45px;">
                                        <div class="avatar-letter bg-primary text-white rounded-circle">@msg.Name.Substring(0, 1).ToUpper()</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark small">@msg.Name</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.75rem; max-width: 200px;">@msg.Subject</div>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-light text-muted fw-normal">@msg.CreatedDate.ToShortDateString()</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* --- SİSTEM DURUMU --- *@
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h6 class="mb-4 fw-bold text-dark"><i class="fas fa-server me-2 text-primary"></i>Sistem & Stok Durumu</h6>
                <div class="d-grid gap-4">
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-bold">Toplam Stok Kapasitesi</span>
                            <span class="small text-primary fw-bold">%85</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 8px;">
                            <div class="progress-bar bg-primary shadow-sm" style="width: 85%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small fw-bold">Aylık Satış Hedefi</span>
                            <span class="small text-success fw-bold">%60</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 8px;">
                            <div class="progress-bar bg-success shadow-sm" style="width: 60%"></div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 p-3 rounded-4 bg-light border border-dashed text-center">
                    <div class="d-flex align-items-center justify-content-center">
                        <div class="spinner-grow spinner-grow-sm text-success me-2"></div>
                        <span class="small text-muted fw-bold">Sistem Çevrimiçi: <span class="text-success">Sorunsuz</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Grafik kimliğini (ID) doğru eşleştirdik
        var ctx = document.getElementById("categoryChart");

        var myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoryCounts)),
                    // Her kategori için farklı renkler
                    backgroundColor: [
                        '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#5a5c69'
                    ],
                    hoverBackgroundColor: [
                        '#2e59d9', '#17a673', '#2c9faf', '#dda20a', '#be2617', '#60616f', '#373840'
                    ],
                    hoverBorderColor: "rgba(234, 236, 244, 1)",
                    borderWidth: 1
                }],
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20
                        }
                    }
                },
                cutout: '70%' // Ortasını biraz daha genişletip şık gösterdik
            }
        });
    </script>
}

<style>
    .fw-extra-bold {
        font-weight: 800;
    }

    .card-hover {
        transition: transform 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
        }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-soft {
        background-color: #eef2ff;
    }

    .bg-success-soft {
        background-color: #ecfdf5;
    }

    .bg-info-soft {
        background-color: #e0f2fe;
    }

    .bg-warning-soft {
        background-color: #fffbeb;
    }

    .avatar-letter {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>