@model IEnumerable<UrunSatisPortali.Models.Product>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4 shadow-sm border-start border-primary border-4">
                <i class="bg-primary text-white h1 mb-0"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2 text-muted">Toplam Ürün</p>
                    <h6 class="mb-0 h4">@ViewBag.ProductCount</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4 shadow-sm border-start border-success border-4">
                <i class="bg-success text-white h1 mb-0"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2 text-muted">Kategoriler</p>
                    <h6 class="mb-0 h4">@ViewBag.CategoryCount</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4 shadow-sm border-start border-info border-4">
                <i class="bg-info text-white h1 mb-0"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2 text-muted">Markalar</p>
                    <h6 class="mb-0 h4">@ViewBag.BrandCount</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4 shadow-sm border-start border-warning border-4">
                <i class="bg-warning text-dark h1 mb-0"></i>
                <div class="ms-3 text-end">
                    <p class="mb-2 text-muted">Yorumlar</p>
                    <h6 class="mb-0 h4">@ViewBag.CommentCount</h6>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-sm-12 col-xl-8">
            <div class="bg-light text-center rounded p-4 shadow-sm">
                <h6 class="mb-4 text-start">Kategori Dağılımı</h6>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
        <div class="col-sm-12 col-xl-4">
            <div class="bg-light rounded p-4 shadow-sm">
                <h6 class="mb-4">Son Eklenen 5 Ürün</h6>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td class="text-end text-primary fw-bold">@item.Price.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                datasets: [{
                    label: 'Ürün Sayısı',
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoryCounts)),
                    backgroundColor: 'rgba(13, 110, 253, 0.6)',
                    borderColor: '#0d6efd',
                    borderWidth: 1
                }]
            }
        });
    </script>
}