@model UrunSatisPortali.Models.Category

@{
    ViewData["Title"] = "Kategoriyi Düzenle";
}

<h1>Kategoriyi Düzenle</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <input type="hidden" asp-for="CreatedDate" />

            <div class="form-group mb-2">
                <label asp-for="Name" class="control-label">Kategori Adı</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="catActive">
                <label class="form-check-label" for="catActive">
                    Aktif mi?
                </label>
            </div>

            <div class="form-group mt-4 d-flex">
                <button type="submit" class="btn btn-success me-2">
                    <i class="fas fa-save"></i> Güncelle
                </button>

               

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Vazgeç
                </a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Kategori Silme Butonu Tıklanınca
            $("#btnDeleteCategory").on("click", function () {
                var categoryId = $(this).data("id");

                if (confirm("Bu kategoriyi silmek istediğinizden emin misiniz? (İçinde ürün varsa silinmez)")) {
                    $.ajax({
                        url: "/Admin/Category/Delete/" + categoryId, // Kategori Controller'a gidiyor
                        method: "POST",
                        success: function (response) {
                            if (response.success) {
                                alert(response.message);
                                // Başarılıysa Kategori Listesine dön
                                window.location.href = "/Admin/Category/Index";
                            } else {
                                // Başarısızsa (örn: içinde ürün varsa) hatayı göster
                                alert(response.message);
                            }
                        },
                        error: function () {
                            alert("Bir sunucu hatası oluştu.");
                        }
                    });
                }
            });
        });
    </script>
}