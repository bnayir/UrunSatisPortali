@model IEnumerable<UrunSatisPortali.Models.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kategori Listesi</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni Kategori Ekle
    </a>
</div>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Kategori Adı</th>
            <th>Durum</th>
            <th>Kayıt Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>

                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pasif</span>
                    }
                </td>

                <td>@item.CreatedDate.ToShortDateString()</td>

                <td style="width: 200px;">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Düzenle
                    </a>
                    <button class="btn btn-danger btn-sm js-delete-category" data-id="@item.Id">
                        <i class="fas fa-trash"></i> Sil
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".js-delete-category").on("click", function () {
                var btn = $(this);
                var id = btn.data("id");
                if (confirm("Bu kategoriyi silmek istediğinizden emin misiniz?")) {
                    $.ajax({
                        url: "/Admin/Category/Delete/" + id,
                        method: "POST",
                        success: function (response) {
                            if (response.success) btn.closest("tr").fadeOut();
                            else alert("Hata: " + response.message);
                        }
                    });
                }
            });
        });
    </script>
}