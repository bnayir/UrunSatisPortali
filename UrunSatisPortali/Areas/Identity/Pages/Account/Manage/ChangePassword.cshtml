@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white p-4">
        <h4 class="mb-0"><i class="fas fa-key me-2"></i> @ViewData["Title"]</h4>
    </div>
    <div class="card-body p-4 bg-white">
        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label fw-bold text-muted small text-uppercase">Mevcut Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-lock-open"></i></span>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Eski şifreniz" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-bold text-muted small text-uppercase">Yeni Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-lock"></i></span>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="En az 6 karakter" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-muted small text-uppercase">Yeni Şifre (Tekrar)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="fas fa-check-double"></i></span>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifreyi tekrar girin" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm transition-up">
                    <i class="fas fa-sync-alt me-2"></i> Şifreyi Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}