@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav nav-pills flex-column mb-4 p-3 bg-white rounded-4 shadow-sm">
    <li class="nav-item mb-2">
        <a class="nav-link rounded-pill @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="fas fa-user me-2"></i> Profil
        </a>
    </li>
    <li class="nav-item mb-2">
        <a class="nav-link rounded-pill @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="fas fa-key me-2"></i> Şifre Değiştir
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill text-danger @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            <i class="fas fa-trash-alt me-2"></i> Verilerimi Sil
        </a>
    </li>
</ul>