@page
@model IndexModel
@{
    ViewData["Title"] = "Profil Bilgilerim";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0"><i class="fas fa-user-circle me-2"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4 bg-white">
                    <partial name="_StatusMessage" for="StatusMessage" />

                    <form id="profile-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Username" class="form-label fw-bold text-muted small text-uppercase">Kullanıcı Adı / E-posta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-at"></i></span>
                                    <input asp-for="Username" class="form-control bg-light border-start-0" placeholder="Kullanıcı adınız" disabled />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Input.PhoneNumber" class="form-label fw-bold text-muted small text-uppercase">Telefon Numarası</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-primary"><i class="fas fa-phone"></i></span>
                                    <input asp-for="Input.PhoneNumber" class="form-control border-start-0" placeholder="05XX XXX XX XX" />
                                </div>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <button id="update-profile-button" type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm transition-up">
                                <i class="fas fa-save me-2"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-up {
        transition: all 0.3s;
    }

        .transition-up:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .card {
        transition: transform 0.3s;
    }

    .input-group-text {
        border-radius: 10px 0 0 10px;
    }

    .form-control {
        border-radius: 0 10px 10px 0;
        padding: 12px;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: #4e73df;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}