@page
@model LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="text-center fw-bold text-success mb-4">Hoş Geldiniz</h2>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-pill px-4" autocomplete="username" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="ms-3">E-posta</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-pill px-4" autocomplete="current-password" placeholder="password" />
                            <label asp-for="Input.Password" class="ms-3">Şifre</label>
                        </div>

                        <div class="checkbox mb-3 ms-3 small">
                            <label asp-for="Input.RememberMe" class="form-label text-muted">
                                <input class="form-check-input" asp-for="Input.RememberMe" /> Beni Hatırla
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-success rounded-pill fw-bold py-3 shadow">Giriş Yap</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>